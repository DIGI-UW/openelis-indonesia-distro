# Build and Release Folders
bin-debug/
bin-release/
[Oo]bj/
[Bb]in/

# Other files and folders
.settings/

# Executables
*.swf
*.air
*.ipa
*.apk
*.DS_Store

# Project files, i.e. `.project`, `.actionScriptProperties` and `.flexProperties`
# should NOT be excluded as they contain compiler settings and other important
# information for Eclipse / Flash Builder.
*.idea


# Database bind mounts and local OE config overrides
configs/logs/
configs/logs/*
configs/database/data*/
**/*checksum*.properties
**/*checksums*.properties
configs/properties/TotalSystemConfiguration.properties
configs/properties/ChangedSystemConfiguration.properties


# Node and Playwright
node_modules/
test-results/
# Re-include the config-import test-results domain (real config); the pattern
# above targets Playwright's output dir and collides with this config path.
!configs/configuration/backend/test-results/
!configs/configuration/backend/test-results/*.csv
playwright-report/
blob-report/
**/playwright/.auth/

# CI and local validation artifacts
test-artifacts/

# IDE and OS
.cursor/
.claude/
.idea/
.DS_Store
